# =====================================================================================
# Modèle de configuration. À copier en .env.local puis à remplir.
#
#   Windows (PowerShell) :  Copy-Item .env.example .env.local
#   Mac / Linux          :  cp .env.example .env.local
#
# Ensuite, vérifier sans rien afficher de secret :   npm run env:verifier
#
# RÈGLES
#  - .env.local est ignoré par git : ne JAMAIS le commiter, ne jamais envoyer son contenu
#    par message ou par e-mail (le résultat de `npm run env:verifier`, lui, est sans danger).
#  - Pas de guillemets, pas d'espace autour du « = ».
#  - Ce fichier sert au PROJET SUPABASE DE DÉVELOPPEMENT. Les valeurs de production se
#    saisissent uniquement dans Vercel (voir docs/09-guide-mise-en-route.md).
# =====================================================================================

# URL publique du site (locale en développement)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase : Réglages du projet → API ---------------------------------------------
# « Project URL », de la forme https://xxxxxxxx.supabase.co (sans rien après .supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# Clé PUBLIQUE : « anon » (ancien format) ou « publishable » (nouveau format).
# Visible par tous les visiteurs : c'est normal, elle est protégée par les règles RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé SECRÈTE : « service_role » (ancien format) ou « secret » (nouveau format).
# Contourne toutes les protections : serveur uniquement, jamais de préfixe NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Base de données : bouton « Connect » en haut du projet ----------------------------
# Remplacer [YOUR-PASSWORD] par le mot de passe de la base.
# Si ce mot de passe contient @ : / ? # % il faut l'encoder (@ → %40, : → %3A, / → %2F…).
# Astuce : un mot de passe de lettres et de chiffres évite tout problème.
#
# Pour le SITE : « Transaction pooler » (port 6543).
DATABASE_URL=
# Pour les MIGRATIONS : « Direct connection » (port 5432).
# ⚠ Si votre réseau n'a pas IPv6 (cas fréquent), la connexion directe échoue : utilisez alors
#   le « Session pooler » (port 5432, serveur ...pooler.supabase.com).
DATABASE_DIRECT_URL=
