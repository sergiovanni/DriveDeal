# Copier ce fichier en .env.local et renseigner les valeurs. Ne JAMAIS committer .env.local.

# URL publique du site (locale en développement)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé serveur uniquement : ne jamais l'exposer au navigateur (pas de préfixe NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Base de données — Project Settings > Database
# URL "poolée" (pooler Supabase) pour l'application sur Vercel
DATABASE_URL=
# Connexion directe, utilisée uniquement pour les migrations
DATABASE_DIRECT_URL=
